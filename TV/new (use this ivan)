class DisjointSet:
    """Disjoint Set Union (Union-Find) for trajectory dot-clustering."""
    def __init__(self, n: int):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, i: int) -> int:
        if self.parent[i] != i:
            self.parent[i] = self.find(self.parent[i])
        return self.parent[i]

    def union(self, i: int, j: int):
        root_i = self.find(i)
        root_j = self.find(j)
        if root_i != root_j:
            if self.rank[root_i] < self.rank[root_j]:
                self.parent[root_i] = root_j
            elif self.rank[root_i] > self.rank[root_j]:
                self.parent[root_j] = root_i
            else:
                self.parent[root_j] = root_i
                self.rank[root_i] += 1


class CloudChamberAnalyzer:
    """
    High-precision trajectory extraction, dot linking, metric calculation, and classification.
    Adheres to:
    - Amendment 1: Links beaded droplets/dots into continuous trajectories; rejects isolated noise dots.
    - Amendment 2: Encloses related dots within a single, wide unified bounding box.
    """

    def __init__(
        self,
        calibrator: Optional[SpatialCalibrator] = None,
        curvilinear_scales: Sequence[float] = (1.2, 2.0, 3.2, 5.0),
        min_track_length_px: float = 24.0,
        alpha_width_threshold_mm: float = 1.40,
        electron_curvature_threshold: float = 0.18,
        max_link_distance_px: float = 50.0,
        min_isolated_dot_area: int = 38
    ):
        self.calibrator = calibrator if calibrator is not None else SpatialCalibrator(pixels_per_cm=40.0)
        self.curvilinear_scales = curvilinear_scales
        self.min_track_length_px = min_track_length_px
        self.alpha_width_threshold_mm = alpha_width_threshold_mm
        self.electron_curvature_threshold = electron_curvature_threshold
        self.max_link_distance_px = max_link_distance_px
        self.min_isolated_dot_area = min_isolated_dot_area

    def preprocess(self, bgr_image: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        """
        Pre-processing pipeline:
        1. Grayscale conversion.
        2. Status-bar / OSD text suppression (for tall screenshots with camera UI at top).
        3. Edge-preserving Bilateral Filter to suppress vapour noise while preserving thin tracks.
        4. Morphological White Top-Hat to level non-uniform cloud chamber illumination.
        5. CLAHE (Contrast Limited Adaptive Histogram Equalisation).
        """
        if len(bgr_image.shape) == 3:
            gray = cv2.cvtColor(bgr_image, cv2.COLOR_BGR2GRAY)
        else:
            gray = bgr_image.copy()

        h, w = gray.shape[:2]

        # Suppress camera status bar / timestamp text in top margin if present (e.g. 1920x1080 frames)
        if h >= 1850 and np.mean(gray[:130, :]) > 10.0:
            gray[:135, :] = 0

        # Step 1: Edge-preserving Bilateral Filter
        denoised = cv2.bilateralFilter(gray, d=7, sigmaColor=35, sigmaSpace=7)

        # Step 2: White Top-Hat illumination levelling
        kernel_bg = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (31, 31))
        top_hat = cv2.morphologyEx(denoised, cv2.MORPH_TOPHAT, kernel_bg)

        # Blend to preserve both faint electron tracks and strong alpha trails
        blended = cv2.addWeighted(denoised, 0.40, top_hat, 0.60, 0)

        # Step 3: Contrast Limited Adaptive Histogram Equalization (CLAHE)
        clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
        enhanced = clahe.apply(blended)

        return gray, enhanced

    def segment_tracks(
        self,
        curvilinear_map: np.ndarray,
        threshold_factor: float = 0.72
    ) -> Tuple[np.ndarray, np.ndarray]:
        """
        Adaptive segmentation and morphological centerline skeleton extraction.
        Preserves true track contours and ridges while rejecting background vapour noise.
        """
        u8_map = np.clip(curvilinear_map * 255.0, 0, 255).astype(np.uint8)
        otsu_val, _ = cv2.threshold(u8_map, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

        thresh_val = max(45, int(otsu_val * threshold_factor))
        _, binary_mask = cv2.threshold(u8_map, thresh_val, 255, cv2.THRESH_BINARY)

        kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
        binary_mask = cv2.morphologyEx(binary_mask, cv2.MORPH_CLOSE, kernel_close)

        skeleton = self._morphological_skeleton(binary_mask)
        return binary_mask, skeleton

    def _morphological_skeleton(self, binary_mask: np.ndarray) -> np.ndarray:
        """Morphological erosion and opening skeleton thinning."""
        img = binary_mask.copy()
        skel = np.zeros(img.shape, np.uint8)
        element = cv2.getStructuringElement(cv2.MORPH_CROSS, (3, 3))

        while True:
            eroded = cv2.erode(img, element)
            opened = cv2.morphologyEx(eroded, cv2.MORPH_OPEN, element)
            temp = cv2.subtract(eroded, opened)
            skel = cv2.bitwise_or(skel, temp)
            img = eroded.copy()
            if cv2.countNonZero(img) == 0:
                break
        return skel

    def analyze_trajectories(
        self,
        binary_mask: np.ndarray,
        skeleton: np.ndarray,
        enhanced_gray: np.ndarray,
        curvilinear_map: Optional[np.ndarray] = None
    ) -> List[Dict[str, Any]]:
        """
        Extract physical parameters, link related condensation dots/fragments into unified
        trajectories, apply wide bounding boxes, and perform physical classification.
        
        Addresses:
        - Amendment 1: When scanning the image, does not detect all isolated white dots;
          identifies when beaded dots/fragments belong to the same particle path and links them.
        - Amendment 2: Circumscribes related dots with a single, wide unified bounding box
          instead of fragmented small squares.
        """
        h_img, w_img = binary_mask.shape[:2]
        dist_transform = cv2.distanceTransform(binary_mask, cv2.DIST_L2, 5)
        num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(
            binary_mask, connectivity=8
        )

        # 1. Extract valid track components and beaded droplets
        raw_tracks = []
        for label in range(1, num_labels):
            area = stats[label, cv2.CC_STAT_AREA]
            if area < 30:
                continue

            comp_mask = (labels == label).astype(np.uint8)
            track_skel = cv2.bitwise_and(skeleton, skeleton, mask=comp_mask)
            skel_pixels = np.column_stack(np.where(track_skel > 0))

            if len(skel_pixels) < 8:
                contours, _ = cv2.findContours(comp_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
                if not contours:
                    continue
                c = max(contours, key=cv2.contourArea)
                arc_len = cv2.arcLength(c, False) / 2.0
                mean_width_px = float(area / max(1.0, arc_len))
            else:
                arc_len = float(len(skel_pixels))
                dt_vals = dist_transform[skel_pixels[:, 0], skel_pixels[:, 1]]
                mean_width_px = float(np.mean(dt_vals) * 2.0)

            # Keep candidate pieces that meet the minimum fragment threshold
            if arc_len < 20.0:
                continue

            x = int(stats[label, cv2.CC_STAT_LEFT])
            y = int(stats[label, cv2.CC_STAT_TOP])
            w = int(stats[label, cv2.CC_STAT_WIDTH])
            h = int(stats[label, cv2.CC_STAT_HEIGHT])
            cx, cy = float(centroids[label, 0]), float(centroids[label, 1])

            m = cv2.moments(comp_mask)
            mu20, mu02, mu11 = m["mu20"], m["mu02"], m["mu11"]
            theta = 0.5 * math.atan2(2.0 * mu11, mu20 - mu02 + 1e-8)

            raw_tracks.append({
                "label": label,
                "area": area,
                "arc_len": arc_len,
                "width_px": mean_width_px,
                "bbox": (x, y, w, h),
                "centroid": (cx, cy),
                "theta": theta,
                "comp_mask": comp_mask,
                "skel_pixels": skel_pixels
            })

        if not raw_tracks:
            return []

        # 2. Trajectory Dot & Fragment Linking via DisjointSet (Amendment 1)
        dsu = DisjointSet(len(raw_tracks))

        for i in range(len(raw_tracks)):
            xi, yi, wi, hi = raw_tracks[i]["bbox"]
            cxi, cyi = raw_tracks[i]["centroid"]
            theta_i = raw_tracks[i]["theta"]

            for j in range(i + 1, len(raw_tracks)):
                xj, yj, wj, hj = raw_tracks[j]["bbox"]
                cxj, cyj = raw_tracks[j]["centroid"]
                theta_j = raw_tracks[j]["theta"]

                # Boundary gap distance
                dx = max(0, max(xi - (xj + wj), xj - (xi + wi)))
                dy = max(0, max(yi - (yj + hj), yj - (yi + hi)))
                gap = math.hypot(dx, dy)

                if gap > self.max_link_distance_px:
                    continue

                phi = math.atan2(cyj - cyi, cxj - cxi)
                diff_i = min(
                    abs(math.atan2(math.sin(theta_i - phi), math.cos(theta_i - phi))),
                    math.pi - abs(math.atan2(math.sin(theta_i - phi), math.cos(theta_i - phi)))
                )
                diff_j = min(
                    abs(math.atan2(math.sin(theta_j - phi), math.cos(theta_j - phi))),
                    math.pi - abs(math.atan2(math.sin(theta_j - phi), math.cos(theta_j - phi)))
                )

                # Link if closely spaced beads or collinear along track trajectory
                if gap <= 16.0 or (diff_i < math.radians(45.0) or diff_j < math.radians(45.0)):
                    dsu.union(i, j)

        # 3. Assemble clusters of linked dots/fragments
        clusters: Dict[int, List[int]] = {}
        for i in range(len(raw_tracks)):
            root = dsu.find(i)
            clusters.setdefault(root, []).append(i)

        tracks = []
        track_id = 1

        for root, indices in clusters.items():
            tot_len_px = sum(raw_tracks[k]["arc_len"] for k in indices)

            # Filter isolated white noise dots (Amendment 1)
            # Standalone single dots shorter than 32 px are rejected as mist artifacts
            if len(indices) == 1 and tot_len_px < 32.0:
                continue

            # Compute wide unified bounding box encompassing all related dots (Amendment 2)
            xs = [raw_tracks[k]["bbox"][0] for k in indices]
            ys = [raw_tracks[k]["bbox"][1] for k in indices]
            x_ends = [raw_tracks[k]["bbox"][0] + raw_tracks[k]["bbox"][2] for k in indices]
            y_ends = [raw_tracks[k]["bbox"][1] + raw_tracks[k]["bbox"][3] for k in indices]

            # Comfortable padding around the cluster for clear framing
            pad = 8
            x_box = max(0, min(xs) - pad)
            y_box = max(0, min(ys) - pad)
            w_box = min(w_img, max(x_ends) + pad) - x_box
            h_box = min(h_img, max(y_ends) + pad) - y_box

            # Combine component masks
            unified_mask = np.zeros_like(binary_mask)
            for idx in indices:
                unified_mask = cv2.bitwise_or(unified_mask, raw_tracks[idx]["comp_mask"])

            # Connect droplet centroids in mask for continuous visual tinting and skeleton
            if len(indices) > 1:
                pts = [raw_tracks[idx]["centroid"] for idx in indices]
                for a in range(len(pts)):
                    p_a = pts[a]
                    best_b = min(
                        [b for b in range(len(pts)) if b != a],
                        key=lambda b: math.hypot(p_a[0] - pts[b][0], p_a[1] - pts[b][1])
                    )
                    pt1 = (int(round(p_a[0])), int(round(p_a[1])))
                    pt2 = (int(round(pts[best_b][0])), int(round(pts[best_b][1])))
                    cv2.line(unified_mask, pt1, pt2, 1, thickness=2)

            # Re-extract skeleton of unified track
            unified_skel = self._morphological_skeleton(unified_mask)
            skel_pixels = np.column_stack(np.where(unified_skel > 0))

            # Length, width, and physical calibration
            length_cm = self.calibrator.px_to_cm(tot_len_px)
            avg_width_px = sum(raw_tracks[k]["width_px"] * raw_tracks[k]["arc_len"] for k in indices) / max(1.0, tot_len_px)
            width_mm = self.calibrator.px_to_mm(avg_width_px)

            curvature, tortuosity = self._calculate_trajectory_curvature(skel_pixels, tot_len_px, w_box, h_box)
            track_intensity = float(np.mean(enhanced_gray[unified_mask > 0]))

            classification, confidence = self._classify_track(
                length_cm=length_cm,
                width_mm=width_mm,
                curvature=curvature,
                tortuosity=tortuosity
            )

            tracks.append({
                "track_id": track_id,
                "classification": classification,
                "confidence": round(confidence, 3),
                "bbox": (x_box, y_box, w_box, h_box),
                "num_dots": len(indices),
                "length_px": round(tot_len_px, 2),
                "length_cm": round(length_cm, 3),
                "width_px": round(avg_width_px, 2),
                "width_mm": round(width_mm, 3),
                "max_width_mm": round(width_mm * 1.25, 3),
                "curvature": round(curvature, 4),
                "tortuosity": round(tortuosity, 4),
                "mean_intensity": round(track_intensity, 1),
                "mask": unified_mask
            })
            track_id += 1

        tracks.sort(key=lambda t: t["length_px"], reverse=True)
        return tracks

    def _calculate_trajectory_curvature(
        self,
        skel_points: np.ndarray,
        arc_length: float,
        bbox_w: int,
        bbox_h: int
    ) -> Tuple[float, float]:
        """Compute chord-to-arc tortuosity and curvature index."""
        if len(skel_points) < 5:
            diag = math.hypot(bbox_w, bbox_h)
            tortuosity = max(0.0, 1.0 - (diag / max(1.0, arc_length)))
            return float(tortuosity * 0.5), float(tortuosity)

        pts = skel_points[:, [1, 0]]
        if len(pts) > 50:
            sub_pts = pts[np.linspace(0, len(pts) - 1, 50, dtype=int)]
        else:
            sub_pts = pts

        diff = sub_pts[:, np.newaxis, :] - sub_pts[np.newaxis, :, :]
        dist_matrix = np.sqrt(np.sum(diff ** 2, axis=-1))
        max_chord = float(np.max(dist_matrix))

        tortuosity = max(0.0, min(1.0, 1.0 - (max_chord / max(1.0, arc_length))))
        curvature = tortuosity * 0.80 + (1.0 - min(bbox_w, bbox_h) / max(1.0, max(bbox_w, bbox_h))) * 0.20
        return float(curvature), float(tortuosity)

    def _classify_track(
        self,
        length_cm: float,
        width_mm: float,
        curvature: float,
        tortuosity: float
    ) -> Tuple[str, float]:
        """
        High-accuracy physical classification adhering to Topic 4 specifications:
        
        Alpha Particle Tracks:
        - Dense ionization column resulting in thick tracks (width >= 1.4 mm).
        - Consistent, short-to-moderate length (<= 6.5 cm, originating from Radon decay).
        - High momentum results in straight or gently deflected propagation.
        - Circumscribed by Yellow Bounding Box.

        Electron Particle Tracks:
        - Weak ionization creates thin tracks (width < 1.4 mm).
        - Easily deflected in magnetic fields, forming curved or circular trajectories.
        - Circumscribed by Red Bounding Box.
        """
        is_thick = width_mm >= self.alpha_width_threshold_mm
        is_short_enough = length_cm <= 6.5
        is_straight = curvature < self.electron_curvature_threshold and tortuosity < 0.25

        alpha_score = 0.0
        if is_thick:
            alpha_score += 0.55
        if is_short_enough:
            alpha_score += 0.25
        if is_straight:
            alpha_score += 0.20

        is_thin = width_mm < self.alpha_width_threshold_mm
        is_bent = curvature >= self.electron_curvature_threshold or tortuosity >= 0.25

        electron_score = 0.0
        if is_thin:
            electron_score += 0.50
        if is_bent:
            electron_score += 0.50

        if alpha_score > electron_score:
            confidence = min(0.99, 0.50 + alpha_score * 0.45)
            return "Alpha", confidence
        else:
            confidence = min(0.99, 0.50 + electron_score * 0.45)
            return "Electron", confidence

    def annotate_detections(
        self,
        original_bgr: np.ndarray,
        tracks: List[Dict[str, Any]]
    ) -> np.ndarray:
        """Draw Yellow Bounding Boxes for Alpha and Red Bounding Boxes for Electron."""
        annotated = original_bgr.copy()
        COLOR_ALPHA_YELLOW = (0, 255, 255)  # BGR
        COLOR_ELECTRON_RED = (0, 0, 255)    # BGR

        for track in tracks:
            x, y, w, h = track["bbox"]
            p_type = track["classification"]
            conf = track["confidence"]
            length_cm = track["length_cm"]
            width_mm = track["width_mm"]

            box_color = COLOR_ALPHA_YELLOW if p_type == "Alpha" else COLOR_ELECTRON_RED

            cv2.rectangle(annotated, (x, y), (x + w, y + h), box_color, 2)

            mask = track["mask"]
            color_layer = np.zeros_like(annotated)
            color_layer[mask > 0] = box_color
            cv2.addWeighted(color_layer, 0.35, annotated, 1.0, 0, annotated)

            label_text = f"#{track['track_id']} {p_type} ({conf*100:.0f}%)"
            sub_text = f"L:{length_cm:.2f}cm W:{width_mm:.2f}mm"

            font = cv2.FONT_HERSHEY_SIMPLEX
            (text_w, text_h), _ = cv2.getTextSize(label_text, font, 0.45, 1)

            badge_y1 = max(0, y - text_h - 16)
            badge_y2 = max(text_h + 16, y)
            badge_x1 = x
            badge_x2 = x + max(text_w, 140) + 8

            cv2.rectangle(annotated, (badge_x1, badge_y1), (badge_x2, badge_y2), (20, 20, 20), -1)
            cv2.rectangle(annotated, (badge_x1, badge_y1), (badge_x2, badge_y2), box_color, 1)

            cv2.putText(annotated, label_text, (badge_x1 + 4, badge_y1 + text_h + 3),
                        font, 0.45, box_color, 1, cv2.LINE_AA)
            cv2.putText(annotated, sub_text, (badge_x1 + 4, badge_y2 - 3),
                        font, 0.38, (220, 220, 220), 1, cv2.LINE_AA)

        # Header legend
        h_img, w_img = annotated.shape[:2]
        banner = annotated[:36, :].copy()
        cv2.rectangle(banner, (0, 0), (w_img, 36), (15, 15, 15), -1)
        cv2.addWeighted(banner, 0.85, annotated[:36, :], 0.15, 0, annotated[:36, :])

        font = cv2.FONT_HERSHEY_SIMPLEX
        cv2.rectangle(annotated, (15, 10), (30, 25), COLOR_ALPHA_YELLOW, -1)
        cv2.putText(annotated, "Alpha Track (Yellow Box, Thick/Straight)", (36, 22), font, 0.45, (255, 255, 255), 1, cv2.LINE_AA)

        cv2.rectangle(annotated, (330, 10), (345, 25), COLOR_ELECTRON_RED, -1)
        cv2.putText(annotated, "Electron Track (Red Box, Thin/Curved)", (352, 22), font, 0.45, (255, 255, 255), 1, cv2.LINE_AA)

        n_alpha = sum(1 for t in tracks if t["classification"] == "Alpha")
        n_elec = sum(1 for t in tracks if t["classification"] == "Electron")
        cv2.putText(annotated, f"Total: {len(tracks)} (Alpha: {n_alpha}, Electron: {n_elec})",
                    (w_img - 260, 22), font, 0.45, (100, 255, 100), 1, cv2.LINE_AA)
        return annotated

    def generate_pipeline_figure(
        self,
        original_bgr: np.ndarray,
        enhanced_gray: np.ndarray,
        curvilinear_map: np.ndarray,
        annotated_bgr: np.ndarray
    ) -> np.ndarray:
        """Create 4-panel diagnostic figure."""
        h, w = original_bgr.shape[:2]
        enhanced_bgr = cv2.cvtColor(enhanced_gray, cv2.COLOR_GRAY2BGR)

        u8_curv = np.clip(curvilinear_map * 255.0, 0, 255).astype(np.uint8)
        curv_colormap = cv2.applyColorMap(u8_curv, cv2.COLORMAP_INFERNO)

        def add_title(img, title):
            p = img.copy()
            cv2.rectangle(p, (0, 0), (w, 30), (0, 0, 0), -1)
            cv2.putText(p, title, (10, 20), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1, cv2.LINE_AA)
            return p

        p1 = add_title(original_bgr, "1. Input Cloud Chamber Image")
        p2 = add_title(enhanced_bgr, "2. Preprocessed (Bilateral + TopHat + CLAHE)")
        p3 = add_title(curv_colormap, "3. Curvilinear Filter Response (Frangi/Hessian)")
        p4 = add_title(annotated_bgr, "4. Track Classification (Yellow: Alpha, Red: Electron)")

        top = np.hstack([p1, p2])
        bottom = np.hstack([p3, p4])
        return np.vstack([top, bottom])


