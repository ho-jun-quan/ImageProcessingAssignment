def run_pipeline():
    """Execute complete analysis pipeline across all cloud chamber images."""
    print("=" * 75)
    print("   BMDS2133 IMAGE PROCESSING - CLOUD CHAMBER PARTICLE TRACK CLASSIFIER")
    print("   Algorithm: Multiscale Curvilinear Filter (Hessian Matrix Scale-Space)")
    print("=" * 75)

    start_time = time.time()
    image_dir, result_dir = locate_directories()
    print(f"[+] Input Directory  : {image_dir}")
    print(f"[+] Output Directory : {result_dir}\n")

    patterns = ["*.jpg", "*.jpeg", "*.png", "*.bmp"]
    image_files = []
    for pat in patterns:
        image_files.extend(image_dir.glob(pat))
        image_files.extend(image_dir.glob(pat.upper()))

    image_files = sorted(list(set(image_files)))
    if not image_files:
        print(f"[-] No images found in {image_dir}!")
        return

    print(f"[+] Found {len(image_files)} cloud chamber images for analysis.\n")

    calibrator = SpatialCalibrator(pixels_per_cm=40.0)
    analyzer = CloudChamberAnalyzer(
        calibrator=calibrator,
        curvilinear_scales=(1.2, 2.0, 3.2, 5.0),
        min_track_length_px=24.0,
        alpha_width_threshold_mm=1.40,
        electron_curvature_threshold=0.18
    )

    all_records = []
    csv_headers = [
        "track_id", "classification", "confidence", "num_dots", "length_px", "length_cm",
        "width_px", "width_mm", "curvature", "tortuosity", "mean_intensity",
        "bbox_x", "bbox_y", "bbox_w", "bbox_h"
    ]

    for idx, img_path in enumerate(image_files, 1):
        filename = img_path.name
        stem = img_path.stem
        print(f"[{idx}/{len(image_files)}] Processing {filename} ...")

        bgr = cv2.imread(str(img_path))
        if bgr is None:
            print(f"    [-] Failed to load {filename}. Skipping.")
            continue

        # 1. Preprocessing (with status bar suppression)
        gray, enhanced = analyzer.preprocess(bgr)

        # 2. Curvilinear Filter
        curv_map = apply_curvilinear_filter(enhanced, sigmas=analyzer.curvilinear_scales)

        # 3. Segmentation & Thinning
        binary_mask, skeleton = analyzer.segment_tracks(curv_map, threshold_factor=0.70)

        # 4. Trajectory Metrics & Physical Classification (with Dot-Linking & Wide Boxing)
        tracks = analyzer.analyze_trajectories(binary_mask, skeleton, enhanced, curv_map)

        # 5. Annotation (Yellow for Alpha, Red for Electron)
        annotated = analyzer.annotate_detections(bgr, tracks)

        # 6. Pipeline Diagnostic Figure
        pipeline_fig = analyzer.generate_pipeline_figure(bgr, enhanced, curv_map, annotated)

        # Save Visual Artifacts to result/
        classified_path = result_dir / f"{stem}_classified.jpg"
        pipeline_path = result_dir / f"{stem}_pipeline.png"
        cv2.imwrite(str(classified_path), annotated)
        cv2.imwrite(str(pipeline_path), pipeline_fig)

        # Save CSV Metrics to result/
        metrics_path = result_dir / f"{stem}_metrics.csv"
        with open(metrics_path, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=csv_headers)
            writer.writeheader()
            for t in tracks:
                x, y, w_box, h_box = t["bbox"]
                rec = {
                    "track_id": t["track_id"],
                    "classification": t["classification"],
                    "confidence": t["confidence"],
                    "num_dots": t.get("num_dots", 1),
                    "length_px": t["length_px"],
                    "length_cm": t["length_cm"],
                    "width_px": t["width_px"],
                    "width_mm": t["width_mm"],
                    "curvature": t["curvature"],
                    "tortuosity": t["tortuosity"],
                    "mean_intensity": t["mean_intensity"],
                    "bbox_x": x,
                    "bbox_y": y,
                    "bbox_w": w_box,
                    "bbox_h": h_box
                }
                writer.writerow(rec)

                master_rec = rec.copy()
                master_rec["image_name"] = filename
                all_records.append(master_rec)

        n_alpha = sum(1 for t in tracks if t["classification"] == "Alpha")
        n_elec = sum(1 for t in tracks if t["classification"] == "Electron")
        print(f"    --> Found {len(tracks)} tracks ({n_alpha} Alpha [Yellow], {n_elec} Electron [Red]).")

    # Master CSV
    master_csv = result_dir / "summary_report.csv"
    with open(master_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=["image_name"] + csv_headers)
        writer.writeheader()
        for r in all_records:
            writer.writerow(r)
    print(f"\n[+] Master CSV saved: {master_csv}")

    # Dashboard & Markdown Report
    dash_path = result_dir / "batch_analysis_dashboard.png"
    if HAS_MATPLOTLIB:
        generate_batch_dashboard_matplotlib(all_records, dash_path)
    else:
        generate_batch_dashboard_opencv(all_records, dash_path)
    print(f"[+] Summary dashboard saved: {dash_path}")

    report_path = result_dir / "analysis_summary_report.md"
    write_summary_report(all_records, report_path)
    print(f"[+] Markdown report saved: {report_path}")

    elapsed = time.time() - start_time
    print(f"\n[SUCCESS] Completed in {elapsed:.2f}s. All outputs placed in: {result_dir}")
    print("=" * 75)


if __name__ == "__main__":
    run_pipeline()
