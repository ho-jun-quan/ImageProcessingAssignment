# 2. SPATIAL CALIBRATOR (PIXEL TO PHYSICAL UNITS)
# =============================================================================

class SpatialCalibrator:
    """Converts pixel measurements to real physical metrics (cm, mm)."""
    def __init__(self, pixels_per_cm: float = 40.0):
        self.pixels_per_cm = max(1e-3, float(pixels_per_cm))
        self.pixels_per_mm = self.pixels_per_cm / 10.0

    def px_to_cm(self, px: float) -> float:
        return px / self.pixels_per_cm

    def px_to_mm(self, px: float) -> float:
        return px / self.pixels_per_mm


