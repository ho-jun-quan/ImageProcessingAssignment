# =============================================================================
# 1. CURVILINEAR FILTER ENGINE (HESSIAN EIGENVALUES & FRANGI VESSELNESS)
# =============================================================================

def compute_gaussian_derivatives_2d(
    image: np.ndarray,
    sigma: float
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """
    Compute 2nd-order spatial Gaussian derivatives (I_xx, I_yy, I_xy) at scale sigma
    using scale-space theory with gamma-normalisation (Lindberg scale normalization).
    """
    radius = max(1, int(round(3.0 * sigma)))
    x = np.arange(-radius, radius + 1, dtype=np.float32)

    var = sigma * sigma
    g = np.exp(-0.5 * (x ** 2) / var)
    g /= np.sum(g)

    dg = -x / var * g
    d2g = (x ** 2 - var) / (var ** 2) * g

    I_xx = cv2.sepFilter2D(image, cv2.CV_32F, d2g, g)
    I_yy = cv2.sepFilter2D(image, cv2.CV_32F, g, d2g)
    I_xy = cv2.sepFilter2D(image, cv2.CV_32F, dg, dg)

    scale_factor = sigma * sigma
    I_xx *= scale_factor
    I_yy *= scale_factor
    I_xy *= scale_factor

    return I_xx, I_yy, I_xy


def compute_hessian_eigenvalues_2d(
    I_xx: np.ndarray,
    I_yy: np.ndarray,
    I_xy: np.ndarray
) -> Tuple[np.ndarray, np.ndarray]:
    """
    Analytically compute eigenvalues (lambda_1, lambda_2) of 2x2 symmetric Hessian
    at each pixel, ordered such that |lambda_1| <= |lambda_2|.
    """
    trace = I_xx + I_yy
    diff = I_xx - I_yy
    discriminant = np.sqrt(np.maximum(diff * diff + 4.0 * (I_xy * I_xy), 0.0))

    mu_1 = 0.5 * (trace + discriminant)
    mu_2 = 0.5 * (trace - discriminant)

    abs_mu1 = np.abs(mu_1)
    abs_mu2 = np.abs(mu_2)

    swap = abs_mu1 > abs_mu2
    lambda_1 = np.where(swap, mu_2, mu_1)
    lambda_2 = np.where(swap, mu_1, mu_2)

    return lambda_1, lambda_2


def apply_curvilinear_filter(
    image: np.ndarray,
    sigmas: Sequence[float] = (1.2, 2.0, 3.2, 5.0),
    beta: float = 0.5
) -> np.ndarray:
    """
    Multiscale Curvilinear (Frangi Vesselness) Filter.
    Accentuates bright particle tracks on dark background across multiple
    spatial scales while suppressing isotropic blobs and background mist.
    """
    img = image.astype(np.float32)
    if img.max() > 1.0:
        img /= 255.0

    max_response = np.zeros_like(img, dtype=np.float32)
    two_beta_sq = 2.0 * (beta ** 2)

    for sigma in sigmas:
        I_xx, I_yy, I_xy = compute_gaussian_derivatives_2d(img, sigma)
        lambda_1, lambda_2 = compute_hessian_eigenvalues_2d(I_xx, I_yy, I_xy)

        # Bright tracks on dark background require negative curvature across the ridge (lambda_2 < 0)
        valid_mask = lambda_2 < 0
        safe_lambda_2 = np.where(np.abs(lambda_2) < 1e-10, 1e-10, lambda_2)

        # Blobness measure R_B = |lambda_1| / |lambda_2|
        r_b = np.abs(lambda_1) / np.abs(safe_lambda_2)

        # Second-order structureness S = sqrt(lambda_1^2 + lambda_2^2)
        s = np.sqrt(lambda_1 ** 2 + lambda_2 ** 2)

        s_val = s[valid_mask]
        c_scale = 0.5 * np.max(s_val) if s_val.size > 0 and np.max(s_val) > 0 else 1.0
        two_c_sq = 2.0 * (c_scale ** 2) if c_scale > 0 else 1.0

        term_rb = np.exp(-(r_b ** 2) / two_beta_sq)
        term_s = 1.0 - np.exp(-(s ** 2) / two_c_sq)
        scale_response = np.where(valid_mask, term_rb * term_s, 0.0)

        max_response = np.maximum(max_response, scale_response)

    res_max = np.max(max_response)
    if res_max > 1e-7:
        max_response /= res_max

    return max_response


