def locate_directories() -> Tuple[Path, Path]:
    """Find input 'image/' and output 'result/' directories."""
    current_dir = Path(__file__).resolve().parent
    candidate_roots = [current_dir.parent, current_dir, Path.cwd()]

    image_dir = None
    result_dir = None

    for root in candidate_roots:
        cand_img = root / "image"
        cand_res = root / "result"
        if cand_img.exists() and cand_img.is_dir():
            image_dir = cand_img
            result_dir = cand_res
            break

    if image_dir is None:
        image_dir = current_dir.parent / "image"
        result_dir = current_dir.parent / "result"

    result_dir.mkdir(parents=True, exist_ok=True)
    return image_dir, result_dir


